# Supabase — copie para .env e preencha com os dados do seu projeto.
# Painel: Project Settings → API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-public-key

# Pix (recebimento de mensalidades). Valor ABERTO (o aluno digita o valor).
VITE_PIX_KEY=chave-pix-da-escola         # CPF (só dígitos), e-mail, telefone +55... ou chave aleatória
VITE_PIX_MERCHANT_NAME=X BJJ SCHOOL      # nome do recebedor (até 25, sem acento)
VITE_PIX_CITY=SAO PAULO                  # cidade (até 15, sem acento)
